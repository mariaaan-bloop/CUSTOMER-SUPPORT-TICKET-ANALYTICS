        <di:waypoint x="1145" y="515" />
        <di:waypoint x="1145" y="495" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="517" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Resolve_Reopened_di" bpmnElement="Flow_Resolve_Reopened">
        <di:waypoint x="1230" y="463" />
        <di:waypoint x="1260" y="463" />
        <di:waypoint x="1260" y="543" />
      </bpmndi:BPMNEdge>
