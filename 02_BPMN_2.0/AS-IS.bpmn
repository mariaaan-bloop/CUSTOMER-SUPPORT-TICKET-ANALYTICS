        <di:waypoint x="1320" y="285" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="404" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CSAT_Yes_di" bpmnElement="Flow_CSAT_Yes">
        <di:waypoint x="1370" y="285" />
        <di:waypoint x="1410" y="285" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1381" y="260" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CSAT_No_di" bpmnElement="Flow_CSAT_No">
        <di:waypoint x="1345" y="260" />
        <di:waypoint x="1345" y="160" />
        <di:waypoint x="1578" y="160" />
        <di:waypoint x="1578" y="141" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="135" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CSAT_End_di" bpmnElement="Flow_CSAT_End">
        <di:waypoint x="1475" y="245" />
        <di:waypoint x="1475" y="160" />
        <di:waypoint x="1578" y="160" />
        <di:waypoint x="1578" y="141" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
