          <dc:Bounds x="1536" y="83" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TicketLogged_di" bpmnElement="Task_TicketLogged">
        <dc:Bounds x="280" y="260" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TicketQueue_di" bpmnElement="Task_TicketQueue">
        <dc:Bounds x="470" y="260" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TicketWaits_di" bpmnElement="Task_TicketWaits">
        <dc:Bounds x="660" y="260" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FirstResponse_di" bpmnElement="Task_FirstResponse">
        <dc:Bounds x="775" y="430" width="170" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WorkTicket_di" bpmnElement="Task_WorkTicket">
        <dc:Bounds x="775" y="535" width="170" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolved_di" bpmnElement="Gateway_Resolved" isMarkerVisible="true">
        <dc:Bounds x="1005" y="543" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1065" y="561" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolveClose_di" bpmnElement="Task_ResolveClose">
        <dc:Bounds x="1060" y="430" width="170" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Reopened_di" bpmnElement="Gateway_Reopened" isMarkerVisible="true">
        <dc:Bounds x="1235" y="543" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1232" y="593" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CSAT_di" bpmnElement="Gateway_CSAT" isMarkerVisible="true">
        <dc:Bounds x="1320" y="260" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1309" y="310" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CSAT_di" bpmnElement="Task_CSAT">
        <dc:Bounds x="1410" y="245" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Log_di" bpmnElement="Flow_Start_Log">
        <di:waypoint x="213" y="123" />
        <di:waypoint x="250" y="123" />
        <di:waypoint x="250" y="292" />
        <di:waypoint x="280" y="292" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Log_Queue_di" bpmnElement="Flow_Log_Queue">
        <di:waypoint x="430" y="292" />
        <di:waypoint x="470" y="292" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Queue_Wait_di" bpmnElement="Flow_Queue_Wait">
        <di:waypoint x="620" y="292" />
        <di:waypoint x="660" y="292" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_Response_di" bpmnElement="Flow_Wait_Response">
        <di:waypoint x="735" y="325" />
        <di:waypoint x="735" y="462" />
        <di:waypoint x="775" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Response_Work_di" bpmnElement="Flow_Response_Work">
        <di:waypoint x="860" y="495" />
        <di:waypoint x="860" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Work_Resolved_di" bpmnElement="Flow_Work_Resolved">
        <di:waypoint x="945" y="568" />
        <di:waypoint x="1005" y="568" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Resolved_No_di" bpmnElement="Flow_Resolved_No">
        <di:waypoint x="1030" y="593" />
        <di:waypoint x="1030" y="650" />
        <di:waypoint x="735" y="650" />
        <di:waypoint x="735" y="567" />
        <di:waypoint x="775" y="567" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="876" y="633" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Resolved_Yes_di" bpmnElement="Flow_Resolved_Yes">
        <di:waypoint x="1030" y="543" />
