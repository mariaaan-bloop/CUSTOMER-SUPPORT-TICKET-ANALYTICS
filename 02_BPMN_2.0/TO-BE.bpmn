<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CustomerSupport" targetNamespace="http://example.com/customer-support-brd" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1" attrib="{&#39;{http://www.w3.org/2001/XMLSchema-instance}schemaLocation&#39;: &#39;http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd&#39;}" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">
  <bpmn:process id="Process_CustomerSupport_TO_BE" name="TO-BE Customer Support Ticket Handling - BRD Aligned" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Reporting" name="MANAGEMENT / REPORTING">
        <bpmn:flowNodeRef>Task_Dashboard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="SUPPORT AGENT">
        <bpmn:flowNodeRef>Task_RecordPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FirstResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WorkTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_04i52yh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reopened</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="SUPPORT SYSTEM">
        <bpmn:flowNodeRef>Task_WaitQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCSAT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="CUSTOMER">
        <bpmn:flowNodeRef>Task_CompleteCSAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CSATRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_TicketSubmitted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_TicketSubmitted" name="Ticket Submitted (Chat / Email / In-App / Phone)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_LogTicket" name="Log Ticket in System">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RouteQueue" name="Assign Ticket to Queue (Manual)">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecordPriority" name="Tag Priority (Manual)">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WaitQueue" name="Ticket Waits in Queue">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FirstResponse" name="Agent Provides First Response">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WorkTicket" name="Agent Works on Ticket">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Resolved" name="Resolved?">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ResolveClose" name="Resolve &#38; Close Ticket">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Reopened" name="Reopened?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>Flow_1te7bft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendCSAT" name="Send Optional CSAT Survey">
      <bpmn:incoming>Flow_0uxtmxt</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompleteCSAT" name="Customer Completes CSAT (Optional)">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CSATRecorded" name="CSAT Recorded (Optional)">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Dashboard" name="Centralized Operational Dashboard - Historical Analysis" />
    <bpmn:dataStoreReference id="DataStore_TicketDataset" name="Support Ticket Dataset (Historical Extract)" dataStoreRef="DataStore_TicketDataset_Def" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_TicketSubmitted" targetRef="Task_LogTicket" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_LogTicket" targetRef="Task_RouteQueue" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_RouteQueue" targetRef="Task_RecordPriority" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_RecordPriority" targetRef="Task_WaitQueue" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_WaitQueue" targetRef="Task_FirstResponse" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_FirstResponse" targetRef="Task_WorkTicket" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_WorkTicket" targetRef="Gw_Resolved" />
    <bpmn:sequenceFlow id="F08" name="No" sourceRef="Gw_Resolved" targetRef="Task_WorkTicket" />
    <bpmn:sequenceFlow id="F09" name="Yes" sourceRef="Gw_Resolved" targetRef="Task_ResolveClose" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_ResolveClose" targetRef="Gw_Reopened" />
    <bpmn:sequenceFlow id="F11" name="Yes" sourceRef="Gw_Reopened" targetRef="Task_WorkTicket" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_CompleteCSAT" targetRef="End_CSATRecorded" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_SendCSAT" targetRef="Task_CompleteCSAT" />
    <bpmn:task id="Activity_04i52yh" name="Ticket Close">
      <bpmn:incoming>Flow_1te7bft</bpmn:incoming>
      <bpmn:outgoing>Flow_0uxtmxt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1te7bft" name="No" sourceRef="Gw_Reopened" targetRef="Activity_04i52yh" />
    <bpmn:sequenceFlow id="Flow_0uxtmxt" sourceRef="Activity_04i52yh" targetRef="Task_SendCSAT" />
    <bpmn:textAnnotation id="Ann_Scope">
      <bpmn:text>BRD scope: reporting and analysis only. No predictive modeling, automated routing, SLA workflow, real-time monitoring, or production workflow changes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Queues">
      <bpmn:text>5 queues: Account, Billing, Integrations, Onboarding, Technical.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_FirstResponse">
      <bpmn:text>Historical first-response time: 1–4,444 minutes; median 83 minutes. Analysis by queue and priority.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Unresolved">
      <bpmn:text>Open / unresolved = blank resolved_at. Historical: 225 of 4,000 tickets.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_CSAT">
      <bpmn:text>CSAT is an optional post-resolution survey; historical response coverage ≈31%.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Reopen">
      <bpmn:text>Reopened is recorded per ticket; dashboard calculates overall and by-queue reopened rate.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Dashboard">
      <bpmn:text>Dashboard uses a static historical extract; it is not real-time/live monitoring.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Metrics">
      <bpmn:text>Dashboard: Volume &amp; Trend | Channel / Queue | First Response | Resolution | Open / Unresolved | Reopened Rate | CSAT | First Response vs CSAT | Filters: Date / Channel / Queue / Priority.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Scope" associationDirection="None" sourceRef="Ann_Scope" targetRef="Task_RouteQueue" />
    <bpmn:association id="Assoc_Queues" associationDirection="None" sourceRef="Ann_Queues" targetRef="Task_RouteQueue" />
    <bpmn:association id="Assoc_FirstResponse" associationDirection="None" sourceRef="Ann_FirstResponse" targetRef="Task_FirstResponse" />
    <bpmn:association id="Assoc_Unresolved" associationDirection="None" sourceRef="Ann_Unresolved" targetRef="Task_WorkTicket" />
    <bpmn:association id="Assoc_CSAT" associationDirection="None" sourceRef="Ann_CSAT" targetRef="Task_CompleteCSAT" />
    <bpmn:association id="Assoc_Reopen" associationDirection="None" sourceRef="Ann_Reopen" targetRef="Gw_Reopened" />
    <bpmn:association id="Assoc_Dashboard" associationDirection="None" sourceRef="Ann_Dashboard" targetRef="DataStore_TicketDataset" />
    <bpmn:association id="Assoc_Metrics" associationDirection="None" sourceRef="Ann_Metrics" targetRef="Task_Dashboard" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_TicketDataset_Def" name="Support Ticket Dataset (Historical Extract)" />
